apk-material/
reverse/apk-extract/
reverse/apktool/
reverse/ghidra-project/
reverse/native/*.so
reverse/native/*.bin
reverse/exports/

# ── 抓包证据与会话密钥(含运行时会话 XOR 密钥，不要提交) ───────────────
reverse/evidence/
reverse/shots/
reverse/evidence-sample.txt
frida/*.jsonl
frida/*.log
frida/trace-cmds-*.json
frida/devlib/
frida/frida-server-*
*.so

